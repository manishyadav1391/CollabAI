# --- Database ---
DATABASE_URL=postgresql://collabai:collabai@localhost:5433/collabai

# --- Redis (queue broker + pub/sub) ---
# Local dev:
REDIS_URL=redis://localhost:6379/0
#
# Redis Cloud (prod) — copy the connection string from Redis Cloud's
# database "Connect" tab (`redis-cli -u redis://default:<password>@<host>:<port>`
# translates directly into this URL):
# REDIS_URL=redis://default:<password>@<host>.db.redis.io:<port>

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Object storage (S3-compatible: MinIO locally, Backblaze B2 in prod) ---
# Local dev (MinIO):
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=collabai_minio
STORAGE_SECRET_ACCESS_KEY=change-me-minio-secret
STORAGE_BUCKET=collabai-documents
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
#
# Backblaze B2 (prod) — swap in your bucket's values, then set path-style to false:
# STORAGE_ENDPOINT_URL=https://s3.<region>.backblazeb2.com
# STORAGE_ACCESS_KEY_ID=<applicationKeyId>
# STORAGE_SECRET_ACCESS_KEY=<applicationKey>
# STORAGE_BUCKET=<bucket-name>
# STORAGE_REGION=<region>          # e.g. us-west-004
# STORAGE_FORCE_PATH_STYLE=false

# --- AI / LLM (required from Phase 5) ---
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Email (required from Phase 6) ---
EMAIL_PROVIDER=          # resend | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:3000

# --- App/environment ---
ENVIRONMENT=local         # local | production
LOG_LEVEL=INFO
