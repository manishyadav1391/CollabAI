# --- Database ---
DATABASE_URL=postgresql://collabai:collabai@localhost:5433/collabai

# --- Redis (queue broker + pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=collabai_minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=collabai-documents

# --- AI / LLM (required from Phase 5) ---
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Email (required from Phase 6) ---
EMAIL_PROVIDER=          # resend | sendgrid | ses
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:3000

# --- App/environment ---
ENVIRONMENT=local         # local | production
LOG_LEVEL=INFO
